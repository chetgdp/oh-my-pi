{
  "type": "module",
  "name": "@oh-my-pi/webgui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    },
    "./components/*": {
      "types": "./src/components/*",
      "import": "./src/components/*"
    },
    "./styles/*": "./src/styles/*",
    "./app": {
      "types": "./src/server/app-types.ts",
      "import": "./src/server/app-types.ts"
    }
  },
  "scripts": {
    "dev": "WEBGUI_DEV=1 bun --hot --no-clear-screen src/server/index.ts",
    "build": "bun scripts/build.ts",
    "watch": "bun scripts/build.ts --watch --serve",
    "serve": "bun src/server/index.ts",
    "test": "bun test --parallel",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
    "attach": "bun scripts/attach.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-coding-agent": "catalog:",
    "@oh-my-pi/pi-tui": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "@panzoom/panzoom": "4.6.2",
    "@tanstack/react-virtual": "3.14.13",
    "idb-keyval": "6.3.0",
    "katex": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fake-indexeddb": "6.2.4"
  }
}
